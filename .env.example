# Copy this file to .env and replace every password with a long, unique value.
# Never commit .env.

# MySQL container configuration
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow_app
MYSQL_PASSWORD=replace-with-a-long-unique-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-long-unique-root-password

# Backend configuration. DB_HOST is `db` for Docker Compose; use `localhost`
# only when running the API outside Docker against an explicitly exposed database.
DB_HOST=db
DB_PORT=3306
DB_NAME=taskflow
DB_USER=taskflow_app
DB_PASSWORD=replace-with-a-long-unique-app-password

# Generate a unique value, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-jwt-signing-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173

